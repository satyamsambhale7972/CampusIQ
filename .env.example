# ====================================================================
# CampusIQ — Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file or API keys to version control.
# ====================================================================

# Environment mode: 'production', 'development', or 'test'
CAMPUSIQ_ENV=production
DEBUG=false

# Server Network Configuration
HOST=0.0.0.0
PORT=8000

# Allowed CORS Origins (comma-separated list of origins)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://satyamsambhale7972.github.io

# Database Connection URL
# For production Supabase PostgreSQL, use the pooled transaction connection string:
# DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres
# For local development or zero-friction testing, leave blank to use the bundled SQLite engine:
DATABASE_URL=sqlite:///campusiq.db

# ====================================================================
# Real-Time Custom SMTP Gateway (Targeting Sub-30s Email Delivery)
# ====================================================================
# Use Gmail SMTP with Google 16-character App Password, or SendGrid/Postmark/Resend.
# Port 587 with STARTTLS is recommended. (Port 25 is blocked by residential ISPs).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM=CampusIQ Security <security@campusiq.edu>
SMTP_SECURE=true
SMTP_TIMEOUT=10.0

# ====================================================================
# Real-Time SMS Gateway (Targeting Sub-30s Phone OTP Delivery)
# ====================================================================
# Set SMS_PROVIDER to 'twilio', 'fast2sms', or 'none'.
SMS_PROVIDER=none
SMS_REQUEST_TIMEOUT=8.0

# Twilio SMS Gateway (Worldwide E.164 SMS Delivery)
# https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890

# Fast2SMS Gateway (Indian Transactional OTP Delivery)
# https://www.fast2sms.com/
FAST2SMS_API_KEY=your-fast2sms-authorization-api-key

# ====================================================================
# Supabase Auth Configuration
# ====================================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-keep-safe
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ====================================================================
# AI Assistant Provider API Key (Kept strictly on backend server)
# ====================================================================
# Google Gemini API key: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=

# Security & Traffic Controls
RATE_LIMIT_PER_MINUTE=120
AI_REQUEST_TIMEOUT=15.0
AI_MAX_RETRIES=2
